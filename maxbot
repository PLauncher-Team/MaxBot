#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
case "${1:-}" in
  status)
    printf '\n=== Состояние системы ===\n'
    printf 'Время работы: '
    uptime -p
    printf 'CPU: %s ядер\n' "$(nproc)"
    printf 'Средняя нагрузка (1, 5, 15 мин): '
    awk '{print $1 ", " $2 ", " $3}' /proc/loadavg
    printf '\n=== Использование памяти ===\n'
    free -h
    printf '\n=== Использование диска ===\n'
    df -h /
    printf '\n=== Контейнеры проекта ===\n'
    docker compose ps
    printf '\n=== Потребление ресурсов контейнерами ===\n'
    docker stats --no-stream --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.NetIO}}\t{{.BlockIO}}'
    ;;
  logs) docker compose logs -f --tail=200 ;;
  restart) docker compose restart ;;
  stop) docker compose down ;;
  update) docker compose build && docker compose up -d ;;
  backup)
    mkdir -p backups
    docker run --rm -v "$(basename "$PWD")_maxbot_data:/data:ro" -v "$PWD/backups:/backup" alpine sh -c 'tar czf /backup/maxbot-data-$(date +%Y%m%d-%H%M%S).tar.gz -C /data .'
    ;;
  clear-db)
    echo "ВНИМАНИЕ: будут безвозвратно удалены все данные приложения и загруженные файлы."
    read -r -p "Для подтверждения введите УДАЛИТЬ: " CONFIRM
    if [[ "$CONFIRM" != "УДАЛИТЬ" ]]; then
      echo "Очистка отменена."
      exit 0
    fi
    docker compose exec -T app node -e '
      const fs = require("fs");
      const path = require("path");
      const db = require("./db");
      const clear = db.transaction(() => db.exec(`
        DELETE FROM recipient_download_tickets;
        DELETE FROM feedback_files;
        DELETE FROM feedback_views;
        DELETE FROM recipient_question_views;
        DELETE FROM recipient_questions;
        DELETE FROM feedback_submissions;
        DELETE FROM responses;
        DELETE FROM participant_groups;
        DELETE FROM participants;
        DELETE FROM groups;
        DELETE FROM reminders;
        DELETE FROM templates;
        DELETE FROM template_seed_state;
        DELETE FROM uploaded_media;
        DELETE FROM sqlite_sequence;
      `));
      clear();
      const uploadsDir = path.join(__dirname, "data", "uploads");
      fs.rmSync(uploadsDir, { recursive: true, force: true });
      fs.mkdirSync(uploadsDir, { recursive: true });
      db.pragma("wal_checkpoint(TRUNCATE)");
      db.close();
      process.stdout.write("База данных и загруженные файлы очищены.\\n");
    '
    ;;
  *) echo "Использование: ./maxbot {status|logs|restart|stop|update|backup|clear-db}"; exit 2 ;;
esac
