#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
case "${1:-}" in
  status)
    printf '\n=== Состояние системы ===\n'
    printf 'Время работы: '
    uptime -p
    printf 'CPU: %s ядер\n' "$(nproc)"
    printf 'Средняя нагрузка (1, 5, 15 мин): '
    awk '{print $1 ", " $2 ", " $3}' /proc/loadavg
    printf '\n=== Использование памяти ===\n'
    free -h
    printf '\n=== Использование диска ===\n'
    df -h /
    printf '\n=== Контейнеры проекта ===\n'
    docker compose ps
    printf '\n=== Потребление ресурсов контейнерами ===\n'
    docker stats --no-stream --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.NetIO}}\t{{.BlockIO}}'
    ;;
  logs) docker compose logs -f --tail=200 ;;
  restart) docker compose restart ;;
  stop) docker compose down ;;
  update) docker compose build && docker compose up -d ;;
  backup)
    mkdir -p backups
    docker run --rm -v "$(basename "$PWD")_maxbot_data:/data:ro" -v "$PWD/backups:/backup" alpine sh -c 'tar czf /backup/maxbot-data-$(date +%Y%m%d-%H%M%S).tar.gz -C /data .'
    ;;
  uninstall)
    if [[ $EUID -ne 0 ]]; then
      exec sudo -E bash "$0" uninstall
    fi
    PROJECT_DIR="$(pwd -P)"
    if [[ "$(basename "$PROJECT_DIR")" != "MaxBot" || ! -f docker-compose.yml ]]; then
      echo "Команду uninstall можно запускать только из корневой папки MaxBot."
      exit 1
    fi
    echo "Будут остановлены и удалены контейнеры MaxBot, а также удалена папка проекта."
    echo "Docker, его образы и тома с данными останутся."
    read -r -p "Продолжить? [y/N]: " CONFIRM
    if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
      echo "Удаление отменено."
      exit 0
    fi
    docker compose down --remove-orphans
    systemctl disable --now maxbot-certbot-renew.timer >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/maxbot-certbot-renew.timer /etc/systemd/system/maxbot-certbot-renew.service
    systemctl daemon-reload
    cd ..
    rm -rf -- "$PROJECT_DIR"
    echo "MaxBot удалён. Docker и тома с данными сохранены."
    ;;
  clear-db)
    echo "ВНИМАНИЕ: будут безвозвратно удалены все данные приложения и загруженные файлы."
    read -r -p "Продолжить? [y/N]: " CONFIRM
    if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
      echo "Очистка отменена."
      exit 0
    fi
    docker compose stop app
    if ! docker compose run --rm --no-deps --user 0 --entrypoint sh app -c 'find /app/data -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + && mkdir -p /app/data'; then
      docker compose up -d app
      exit 1
    fi
    docker compose up -d app
    echo "Данные приложения полностью очищены."
    ;;
  *) echo "Использование: ./maxbot {status|logs|restart|stop|update|backup|clear-db|uninstall}"; exit 2 ;;
esac
